<Window x:Class="ScadaGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ScadaGUI"
        mc:Ignorable="d"
        Title="SCADA Application" Height="450" Width="800" 
        Closing="Window_Closing">
    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">

            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>

            <DataGrid ItemsSource="{Binding IOElements}"
                      AlternatingRowBackground="#F2F2F2"/>

            <Button Content="Add tag" HorizontalAlignment="Left" Grid.Row="1"
                    VerticalAlignment="Bottom" Height="30" Width="150" Margin="15"
                    Click="Button_AddTag"/>
        </Grid>

        <Grid Grid.Column="1">

            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            
        </Grid>

        <StackPanel Grid.Column="1" DataContext="{Binding TestanalogInput}" Background="#66E0E0" Margin="0,0,0,10" Width="250" Height="100">
            <TextBlock Text="Senzor" FontSize="14" FontWeight="Bold"/>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Name}" />
                <TextBlock Text=": " />
                <TextBlock Text="{Binding Address}" />
                <TextBlock Text="{Binding Type}" />
            </StackPanel>
        </StackPanel>
    </Grid>

</Window>
