<Window x:Class="ScadaGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ScadaGUI"
        xmlns:converters="clr-namespace:ScadaGUI.Converters"
        mc:Ignorable="d"
        Title="SCADA Application" Height="620" Width="1450" MinHeight="560" MinWidth="1200"
        Closing="Window_Closing"
        PreviewMouseDown="Window_PreviewMouseDown">
    <Window.Resources>
        <DataTemplate x:Key="SectionHeaderTemplate">
            <TextBlock Text="{Binding}" FontWeight="SemiBold" FontSize="14"
                       Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
        </DataTemplate>
        <converters:ValueWithUnitsConverter x:Key="ValueWithUnitsConverter"/>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.4*"/>
            <ColumnDefinition Width="1.7*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Margin="0,0,0,16">
                <WrapPanel>
                    <TextBlock Text="Filter:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox Width="180" VerticalAlignment="Center" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                    <ComboBox Width="140" Margin="12,0,0,0" VerticalAlignment="Center"
                              ItemsSource="{Binding TagFilterOptions}"
                              SelectedItem="{Binding SelectedTagTypeFilter, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Content="Open History" Height="30" MinWidth="120" Margin="12,0,0,0" Click="Button_ShowHistory"/>
                </WrapPanel>
                <Button x:Name="ThemeToggleButton" Content="Switch to Dark" Height="30" MinWidth="120"
                        HorizontalAlignment="Left" Margin="0,10,0,0" Click="Button_ToggleTheme"/>
            </StackPanel>

            <DataGrid Grid.Row="1"
                      ItemsSource="{Binding FilteredIOElements}"
                      AutoGenerateColumns="False"
                      SelectedItem="{Binding SelectedTag, Mode=TwoWay}"
                      IsReadOnly="True"
                      Margin="0,0,0,16">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="120"/>
                    <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="100"/>
                    <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="70"/>
                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="150"/>
                    <DataGridTextColumn Header="Current Value" Width="120">
                        <DataGridTextColumn.Binding>
                            <MultiBinding Converter="{StaticResource ValueWithUnitsConverter}">
                                <Binding Path="CurrentValue"/>
                                <Binding Path="Units"/>
                            </MultiBinding>
                        </DataGridTextColumn.Binding>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>

            <WrapPanel Grid.Row="2" Margin="0,10,0,0">
                <Button Content="Add tag" Height="30" MinWidth="95" Margin="0,0,10,0"
                        Click="Button_AddTag"/>
                <Button Content="View tag" Height="30" MinWidth="95" Margin="0,0,10,0"
                        Click="Button_ViewTag"/>
                <Button Content="Update tag" Height="30" MinWidth="95" Margin="0,0,10,0"
                        Click="Button_UpdateTag"/>
                <Button Content="Delete tag" Height="30" MinWidth="95" Margin="0,0,10,0"
                        Click="Button_DeleteTag"/>
                <Button x:Name="DeleteAlarmButton" Content="Delete alarm" Height="30" MinWidth="95"
                        Click="Button_DeleteAlarm"/>
            </WrapPanel>
        </Grid>

        <Grid Grid.Column="1" Margin="16,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <GroupBox Grid.Row="0" Header="Selected Tag" HeaderTemplate="{StaticResource SectionHeaderTemplate}" Padding="12" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Name:" FontWeight="Bold"/>
                    <TextBlock Text="{Binding SelectedTag.Name}" Margin="0,0,0,8"/>
                    <TextBlock Text="Address:" FontWeight="Bold"/>
                    <TextBlock Text="{Binding SelectedTag.Address}" Margin="0,0,0,8"/>
                    <TextBlock Text="Type:" FontWeight="Bold"/>
                    <TextBlock Text="{Binding SelectedTag.Type}" Margin="0,0,0,8"/>
                    <TextBlock Text="Unit:" FontWeight="Bold"/>
                    <TextBlock Text="{Binding SelectedTag.Units, FallbackValue=n/a, TargetNullValue=n/a}" Margin="0,0,0,8"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Grid.Row="1" Header="Alarms" HeaderTemplate="{StaticResource SectionHeaderTemplate}" Padding="12">
                <DockPanel>
                    <Button x:Name="AcknowledgeAlarmButton"
                            DockPanel.Dock="Bottom"
                            Content="Acknowledge Alarm"
                            MinWidth="220"
                            Height="30"
                            Margin="0,12,0,0"
                            HorizontalAlignment="Left"
                            IsEnabled="False"
                            Click="Button_AcknowledgeAlarm"/>
                    <DataGrid x:Name="ActiveAlarmsGrid"
                              ItemsSource="{Binding ActiveAlarms}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              SelectedItem="{Binding SelectedAlarm, Mode=TwoWay}"
                              SelectionMode="Extended"
                              SelectionUnit="FullRow"
                              SelectionChanged="ActiveAlarmsGrid_SelectionChanged"
                              MinHeight="120"
                              CanUserAddRows="False">
                        <DataGrid.RowStyle>
                            <!-- State color coding: default is green (never fired, i.e.
                                 HasOccurred=False). Once an alarm has fired (HasOccurred=
                                 True) it defaults to red, whether still active or back
                                 to normal, until acknowledged, since an unacknowledged
                                 return-to-normal must still demand attention rather than
                                 quietly go green. Acknowledging it then shows yellow while
                                 still active, or green immediately once it's back to
                                 normal (no yellow detour). -->
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource MaterialDesignDataGridRow}">
                                <Setter Property="Background" Value="{DynamicResource AlarmInactiveBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AlarmInactiveForegroundBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasOccurred}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource AlarmActiveBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource AlarmActiveForegroundBrush}"/>
                                    </DataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding HasOccurred}" Value="True"/>
                                            <Condition Binding="{Binding IsAcknowledged}" Value="True"/>
                                            <Condition Binding="{Binding IsActive}" Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Background" Value="{DynamicResource AlarmAcknowledgedBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource AlarmAcknowledgedForegroundBrush}"/>
                                    </MultiDataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding HasOccurred}" Value="True"/>
                                            <Condition Binding="{Binding IsAcknowledged}" Value="True"/>
                                            <Condition Binding="{Binding IsActive}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Background" Value="{DynamicResource AlarmInactiveBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource AlarmInactiveForegroundBrush}"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Resources>
                            <!-- Every column sizes to its own content (Width="Auto"),
                                 not to fill leftover space. Tag/Alarm can hold free-text
                                 that's occasionally long, so they cap out at MaxWidth
                                 (~20 characters) and ellipsis-trim anything longer,
                                 instead of stretching the table to fit. -->
                            <Style x:Key="AlarmCellTextStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Margin" Value="6,4,6,4"/>
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tag" Binding="{Binding TagName}" Width="Auto" MinWidth="70" MaxWidth="150" ElementStyle="{StaticResource AlarmCellTextStyle}"/>
                            <DataGridTextColumn Header="Alarm" Binding="{Binding AlarmName}" Width="Auto" MinWidth="60" MaxWidth="150" ElementStyle="{StaticResource AlarmCellTextStyle}"/>
                            <DataGridTextColumn Header="Low" Binding="{Binding LowLimit, StringFormat='F2'}" Width="Auto" MinWidth="50" ElementStyle="{StaticResource AlarmCellTextStyle}"/>
                            <DataGridTextColumn Header="High" Binding="{Binding HighLimit, StringFormat='F2'}" Width="Auto" MinWidth="50" ElementStyle="{StaticResource AlarmCellTextStyle}"/>
                            <DataGridTextColumn Header="Pri." Binding="{Binding Priority}" Width="Auto" MinWidth="40" ElementStyle="{StaticResource AlarmCellTextStyle}"/>
                            <DataGridTextColumn Header="Time" Binding="{Binding Timestamp, StringFormat='HH:mm:ss'}" Width="Auto" MinWidth="65" ElementStyle="{StaticResource AlarmCellTextStyle}"/>
                            <DataGridCheckBoxColumn Header="Ack" Binding="{Binding ShowAcknowledged, Mode=OneWay}" Width="Auto" MinWidth="45"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </GroupBox>
        </Grid>
    </Grid>
</Window>
