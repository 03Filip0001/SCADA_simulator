<Window x:Class="ScadaGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ScadaGUI"
        mc:Ignorable="d"
        Title="SCADA Application" Height="620" Width="1100" MinHeight="560" MinWidth="980"
        Closing="Window_Closing">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="1.2*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Filter:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox Width="180" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                <ComboBox Width="140" Margin="10,0,0,0"
                          ItemsSource="{Binding TagFilterOptions}"
                          SelectedItem="{Binding SelectedTagTypeFilter, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Content="Open History" Width="120" Margin="10,0,0,0" Click="Button_ShowHistory"/>
            </StackPanel>

            <DataGrid Grid.Row="1"
                      ItemsSource="{Binding FilteredIOElements}"
                      AlternatingRowBackground="#F2F2F2"
                      AutoGenerateColumns="False"
                      SelectedItem="{Binding SelectedTag, Mode=TwoWay}"
                      IsReadOnly="True"
                      Margin="0,0,0,10">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="120"/>
                    <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="100"/>
                    <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="70"/>
                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="150"/>
                    <DataGridTextColumn Header="Current Value" Binding="{Binding CurrentValue, StringFormat='F2'}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>

            <WrapPanel Grid.Row="2" Margin="0,4,0,0">
                <Button Content="Add tag" Height="30" Width="95" Margin="0,0,8,0"
                        Click="Button_AddTag"/>
                <Button Content="View tag" Height="30" Width="95" Margin="0,0,8,0"
                        Click="Button_ViewTag"/>
                <Button Content="Update tag" Height="30" Width="95" Margin="0,0,8,0"
                        Click="Button_UpdateTag"/>
                <Button Content="Delete tag" Height="30" Width="95" Margin="0,0,8,0"
                        Click="Button_DeleteTag"/>
                <Button Content="Delete alarm" Height="30" Width="95"
                        Click="Button_DeleteAlarm"/>
            </WrapPanel>
        </Grid>

        <Grid Grid.Column="1" Margin="10,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <GroupBox Grid.Row="0" Header="Selected Tag" Padding="8" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="Name:" FontWeight="Bold"/>
                    <TextBlock Text="{Binding SelectedTag.Name}" Margin="0,0,0,6"/>
                    <TextBlock Text="Address:" FontWeight="Bold"/>
                    <TextBlock Text="{Binding SelectedTag.Address}" Margin="0,0,0,6"/>
                    <TextBlock Text="Type:" FontWeight="Bold"/>
                    <TextBlock Text="{Binding SelectedTag.Type}" Margin="0,0,0,6"/>
                    <TextBlock Text="Selected tag details will appear here." FontStyle="Italic" Foreground="Gray"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Grid.Row="1" Header="Active Alarms" Padding="8">
                <DockPanel>
                    <Button x:Name="AcknowledgeAlarmButton"
                            DockPanel.Dock="Bottom"
                            Content="Acknowledge Alarm"
                            Width="220"
                            Height="30"
                            Margin="0,8,0,0"
                            HorizontalAlignment="Left"
                            IsEnabled="False"
                            Click="Button_AcknowledgeAlarm"/>
                    <DataGrid x:Name="ActiveAlarmsGrid"
                              ItemsSource="{Binding ActiveAlarms}"
                              AutoGenerateColumns="False"
                              HeadersVisibility="Column"
                              SelectedItem="{Binding SelectedAlarm, Mode=TwoWay}"
                              SelectionMode="Extended"
                              SelectionUnit="FullRow"
                              SelectionChanged="ActiveAlarmsGrid_SelectionChanged"
                              MinHeight="120"
                              CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tag" Binding="{Binding TagName}" Width="*"/>
                            <DataGridTextColumn Header="Alarm" Binding="{Binding AlarmName}" Width="*"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding AlarmType}" Width="*"/>
                            <DataGridTextColumn Header="Priority" Binding="{Binding Priority}" Width="Auto"/>
                            <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="2*"/>
                            <DataGridTextColumn Header="Time" Binding="{Binding Timestamp}" Width="*"/>
                            <DataGridTextColumn Header="Ack" Binding="{Binding IsAcknowledged}" Width="Auto"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </GroupBox>
        </Grid>
    </Grid>
</Window>
