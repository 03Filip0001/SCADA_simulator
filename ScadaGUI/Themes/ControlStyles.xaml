<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <!-- Material Design (BundledTheme + MaterialDesign2.Defaults.xaml, merged by
         ThemeManager) already supplies theme-aware implicit styles for Button,
         TextBox, ComboBox, CheckBox, GroupBox, Label, DataGrid and its parts, etc.
         Only what needs tuning for this dense, utility-style UI is overridden here. -->

    <Style TargetType="Window" BasedOn="{StaticResource MaterialDesignWindow}"/>

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}"/>
    </Style>

    <!-- The default MaterialDesignRaisedButton (solid accent fill + elevation shadow)
         is too heavy for a toolbar with many small action buttons side by side.
         Outlined keeps a clear clickable affordance without the visual weight.
         The default horizontal padding (16px each side) is trimmed down since this
         app's buttons are sized tightly around their captions. -->
    <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
        <Setter Property="Padding" Value="10,4,10,4"/>
    </Style>

    <!-- The default MaterialDesignGroupBox paints its header bar in the accent
         color (ColorZoneAssist.Mode=PrimaryMid), which clashes with the accent
         borders on buttons elsewhere. Standard keeps a neutral, subdued header. -->
    <Style TargetType="GroupBox" BasedOn="{StaticResource MaterialDesignGroupBox}">
        <Setter Property="materialDesign:ColorZoneAssist.Mode" Value="Standard"/>
    </Style>

</ResourceDictionary>
