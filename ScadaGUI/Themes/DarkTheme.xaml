<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System.Windows;assembly=PresentationFramework">

    <!-- Brushes for the hand-drawn History graph (Canvas/Polyline/Line), which
         has no Material Design equivalent. Standard controls get their Light/Dark
         palette from Material Design's own BundledTheme instead. -->
    <SolidColorBrush x:Key="SecondaryForegroundBrush" Color="#FFA8A8A8"/>
    <SolidColorBrush x:Key="GridLineBrush" Color="#FF4A4A4A"/>
    <SolidColorBrush x:Key="ChartLineBrush" Color="#FF4FA8FF"/>

    <!-- Safety net for any native chrome that isn't covered by a Material Design
         control template (e.g. an OS-drawn fallback) and would otherwise still
         source its look from SystemColors, leaking the light OS theme through. -->
    <SolidColorBrush x:Key="{x:Static sys:SystemColors.WindowBrushKey}" Color="#FF2D2D30"/>
    <SolidColorBrush x:Key="{x:Static sys:SystemColors.WindowTextBrushKey}" Color="#FFE0E0E0"/>
    <SolidColorBrush x:Key="{x:Static sys:SystemColors.ControlBrushKey}" Color="#FF3C3C3C"/>
    <SolidColorBrush x:Key="{x:Static sys:SystemColors.ControlTextBrushKey}" Color="#FFE0E0E0"/>
    <SolidColorBrush x:Key="{x:Static sys:SystemColors.ControlLightBrushKey}" Color="#FF505050"/>
    <SolidColorBrush x:Key="{x:Static sys:SystemColors.ControlDarkBrushKey}" Color="#FF1E1E1E"/>
    <SolidColorBrush x:Key="{x:Static sys:SystemColors.GrayTextBrushKey}" Color="#FF9A9A9A"/>
    <SolidColorBrush x:Key="{x:Static sys:SystemColors.HighlightBrushKey}" Color="#FF3399FF"/>
    <SolidColorBrush x:Key="{x:Static sys:SystemColors.HighlightTextBrushKey}" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="{x:Static sys:SystemColors.MenuBrushKey}" Color="#FF2D2D30"/>
    <SolidColorBrush x:Key="{x:Static sys:SystemColors.MenuTextBrushKey}" Color="#FFE0E0E0"/>

</ResourceDictionary>
