<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Brushes for the hand-drawn History graph (Canvas/Polyline/Line), which
         has no Material Design equivalent. Standard controls get their Light/Dark
         palette from Material Design's own BundledTheme instead. -->
    <SolidColorBrush x:Key="SecondaryForegroundBrush" Color="#FF6E6E6E"/>
    <SolidColorBrush x:Key="GridLineBrush" Color="#FFD0D0D0"/>
    <SolidColorBrush x:Key="ChartLineBrush" Color="#FF1F6FC5"/>

    <!-- Alarms grid row states: Red = active & unacknowledged, Yellow = acknowledged,
         Green = inactive (back within the normal range, unacknowledged). -->
    <SolidColorBrush x:Key="AlarmActiveBrush" Color="#FFD32F2F"/>
    <SolidColorBrush x:Key="AlarmActiveForegroundBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="AlarmAcknowledgedBrush" Color="#FFFFD54F"/>
    <SolidColorBrush x:Key="AlarmAcknowledgedForegroundBrush" Color="#FF1A1A1A"/>
    <SolidColorBrush x:Key="AlarmInactiveBrush" Color="#FF66BB6A"/>
    <SolidColorBrush x:Key="AlarmInactiveForegroundBrush" Color="#FF1A1A1A"/>

</ResourceDictionary>
