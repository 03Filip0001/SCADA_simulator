    <SolidColorBrush x:Key="PrimaryForegroundBrush" Color="#FF1E1E1E"/>
    <SolidColorBrush x:Key="SecondaryForegroundBrush" Color="#FF6E6E6E"/>
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#FFFFFFFF"/>
