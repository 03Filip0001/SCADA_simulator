<Window x:Class="ScadaGUI.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="History" Height="520" Width="700" MinHeight="420" MinWidth="560">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" FontSize="16" FontWeight="Bold" Margin="0,0,0,10" />

        <Border Grid.Row="1" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="4"
                Padding="10" Background="{DynamicResource PanelBackgroundBrush}">
            <Grid>
                <TextBlock x:Name="NoDataText" TextWrapping="Wrap"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontStyle="Italic" Foreground="Gray" Visibility="Collapsed"/>
                <Canvas x:Name="ChartCanvas" ClipToBounds="True" SizeChanged="ChartCanvas_SizeChanged"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
            <TextBlock Text="Min: " FontWeight="Bold"/>
            <TextBlock x:Name="MinText" Margin="0,0,20,0"/>
            <TextBlock Text="Max: " FontWeight="Bold"/>
            <TextBlock x:Name="MaxText" Margin="0,0,20,0"/>
            <TextBlock Text="Average: " FontWeight="Bold"/>
            <TextBlock x:Name="AverageText"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Close" Width="100" Click="Button_Close"/>
        </StackPanel>
    </Grid>
</Window>
