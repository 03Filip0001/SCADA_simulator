<Window x:Class="ScadaGUI.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="History" Height="380" Width="520">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" FontSize="16" FontWeight="Bold" Margin="0,0,0,10" />

        <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="1" CornerRadius="4" Padding="10" Background="#FFF8F8F8">
            <StackPanel>
                <TextBlock Text="History chart placeholder" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <TextBlock Text="Ovde će kasnije biti prikazan graf istorije vrednosti za selektovani analogni tag." TextWrapping="Wrap"/>
                <Rectangle Height="200" Fill="#FFEFEFEF" Margin="0,10,0,0" Stroke="Gray" StrokeDashArray="4 2"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Close" Width="100" Click="Button_Close"/>
        </StackPanel>
    </Grid>
</Window>
